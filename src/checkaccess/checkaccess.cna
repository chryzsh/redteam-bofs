#
# checkaccess BOF - Directory Read Access Probe
#
# Probes read access on a single directory path (UNC or local) and depth-1
# subdirectories by default, or recursively with -r.
#

beacon_command_register(
    "checkaccess",
    "Probe read access on a directory path and subdirectories (UNC/local)",
    "Synopsis: checkaccess [--recursive|-r] [--suppress-access-denied|-s] <path>\n\n" .
    "Probe read access on a directory path using a FindFirstFileW listing check.\n" .
    "When the path is accessible, immediate subdirectories are also probed.\n" .
    "Use -r to recurse through all nested subdirectories.\n" .
    "Output mirrors enumshares verdict style.\n\n" .
    "Arguments:\n" .
    "  --recursive, -r      Recursively probe all nested subdirectories\n" .
    "  --suppress-access-denied, --suppress-denied, -s\n" .
    "                        Hide subdirectory lines with '[-] Access denied'\n" .
    "  <path>                Directory path to probe (UNC or local)\n" .
    "                        Examples: \\\\test\\dept, \\\\server\\share\\projects, C:\\Users\\Public\n\n" .
    "Examples:\n" .
    "  checkaccess \\\\test\\dept\n" .
    "  checkaccess -r \\\\test\\dept\n" .
    "  checkaccess --suppress-access-denied \\\\test\\dept\n" .
    "  checkaccess -r --suppress-access-denied \\\\test\\dept\n" .
    "  checkaccess \\\\fileserver\\projects\\retail\n" .
    "  checkaccess C:\\Users\\Public\n\n" .
    "Notes:\n" .
    "  - One parent path per invocation\n" .
    "  - Checks depth 1 by default; use -r for full recursive traversal\n" .
    "  - Directory read access checks only\n" .
    "  - Primary use case is UNC path access probing\n"
);

alias checkaccess {
    local('$bof $args $path $suppressDenied $recursive $i $arg');

    if (size(@_) < 2) {
        berror($1, "Usage: checkaccess [--recursive|-r] [--suppress-access-denied|-s] <path>");
        berror($1, "Example: checkaccess \\\\test\\dept");
        return;
    }

    $path = "";
    $suppressDenied = 0;
    $recursive = 0;

    for ($i = 1; $i < size(@_); $i++) {
        $arg = @_[$i];

        if ($arg eq "--recursive" || $arg eq "-r") {
            $recursive = 1;
        }
        else if ($arg eq "--suppress-access-denied" || $arg eq "--suppress-denied" || $arg eq "-s") {
            $suppressDenied = 1;
        }
        else if (strlen($path) == 0) {
            $path = $arg;
        }
        else {
            berror($1, "Usage: checkaccess [--recursive|-r] [--suppress-access-denied|-s] <path>");
            return;
        }
    }

    if (strlen($path) == 0) {
        berror($1, "Path cannot be empty");
        return;
    }

    $bof = script_resource("checkaccess." . barch($1) . ".o");
    if (!-exists $bof) {
        berror($1, "BOF file not found: " . $bof);
        return;
    }

    # Pack arguments: Zii (path, suppressAccessDenied, recursive)
    $args = bof_pack($1, "Zii", $path, $suppressDenied, $recursive);

    beacon_inline_execute($1, readbof($bof), "go", $args);
}
